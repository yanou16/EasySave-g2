<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EasySave</AssemblyName>
    <RootNamespace>EasySave.Views.Console</RootNamespace>
    <!-- Publish as self-contained single-file for Windows x64 — no .NET runtime required on target machine. -->
    <!-- PublishTrimmed intentionally omitted: JSON reflection (SettingsService) breaks when trimmed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Views reference only ViewModels and Models (pure DTOs). Never EasyLog directly. -->
  <ItemGroup>
    <ProjectReference Include="..\EasySave.ViewModels\EasySave.ViewModels.csproj" />
    <ProjectReference Include="..\EasySave.Models\EasySave.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.json" />
    <None Update="Resources\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyCryptoSoftExecutable" AfterTargets="Build;Publish">
    <ItemGroup>
      <CryptoSoftExecutable Include="..\CryptoSoft\bin\$(Configuration)\net8.0\CryptoSoft" Condition="Exists('..\CryptoSoft\bin\$(Configuration)\net8.0\CryptoSoft')" />
      <CryptoSoftExecutable Include="..\CryptoSoft\bin\$(Configuration)\net8.0\CryptoSoft.exe" Condition="Exists('..\CryptoSoft\bin\$(Configuration)\net8.0\CryptoSoft.exe')" />
      <CryptoSoftExecutable Include="..\CryptoSoft\bin\$(Configuration)\net8.0\CryptoSoft.dll" />
      <CryptoSoftExecutable Include="..\CryptoSoft\bin\$(Configuration)\net8.0\CryptoSoft.deps.json" />
      <CryptoSoftExecutable Include="..\CryptoSoft\bin\$(Configuration)\net8.0\CryptoSoft.runtimeconfig.json" />
      <CryptoSoftExecutable Include="..\CryptoSoft\bin\$(Configuration)\net8.0\$(RuntimeIdentifier)\CryptoSoft" Condition="Exists('..\CryptoSoft\bin\$(Configuration)\net8.0\$(RuntimeIdentifier)\CryptoSoft')" />
      <CryptoSoftExecutable Include="..\CryptoSoft\bin\$(Configuration)\net8.0\$(RuntimeIdentifier)\CryptoSoft.exe" Condition="Exists('..\CryptoSoft\bin\$(Configuration)\net8.0\$(RuntimeIdentifier)\CryptoSoft.exe')" />
      <CryptoSoftExecutable Include="..\CryptoSoft\bin\$(Configuration)\net8.0\$(RuntimeIdentifier)\CryptoSoft.dll" Condition="Exists('..\CryptoSoft\bin\$(Configuration)\net8.0\$(RuntimeIdentifier)\CryptoSoft.dll')" />
      <CryptoSoftExecutable Include="..\CryptoSoft\bin\$(Configuration)\net8.0\$(RuntimeIdentifier)\CryptoSoft.deps.json" Condition="Exists('..\CryptoSoft\bin\$(Configuration)\net8.0\$(RuntimeIdentifier)\CryptoSoft.deps.json')" />
      <CryptoSoftExecutable Include="..\CryptoSoft\bin\$(Configuration)\net8.0\$(RuntimeIdentifier)\CryptoSoft.runtimeconfig.json" Condition="Exists('..\CryptoSoft\bin\$(Configuration)\net8.0\$(RuntimeIdentifier)\CryptoSoft.runtimeconfig.json')" />
    </ItemGroup>
    <PropertyGroup>
      <CryptoSoftDestination Condition="'$(PublishDir)' != ''">$(PublishDir)</CryptoSoftDestination>
      <CryptoSoftDestination Condition="'$(CryptoSoftDestination)' == ''">$(OutDir)</CryptoSoftDestination>
    </PropertyGroup>
    <Copy SourceFiles="@(CryptoSoftExecutable)" DestinationFolder="$(CryptoSoftDestination)" SkipUnchangedFiles="true" />
  </Target>
</Project>
