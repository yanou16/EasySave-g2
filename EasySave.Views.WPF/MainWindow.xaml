<Window x:Class="EasySave.Views.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasySave 2.0" Height="540" Width="860"
        MinHeight="420" MinWidth="640">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header : title + language switcher -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitle" Text="EasySave 2.0"
                       FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TxtLangLabel" Text="Language :"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbLanguage" Width="80"
                          SelectionChanged="CmbLanguage_SelectionChanged">
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="Français" Tag="fr"/>
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <!-- Jobs list -->
        <DataGrid Grid.Row="1"
                  x:Name="JobsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColId"     Header="Id"     Binding="{Binding Id}"              Width="40"/>
                <DataGridTextColumn x:Name="ColName"   Header="Name"   Binding="{Binding Name}"            Width="*"/>
                <DataGridTextColumn x:Name="ColSource" Header="Source" Binding="{Binding SourceDirectory}" Width="2*"/>
                <DataGridTextColumn x:Name="ColTarget" Header="Target" Binding="{Binding TargetDirectory}" Width="2*"/>
                <DataGridTextColumn x:Name="ColType"   Header="Type"   Binding="{Binding Type}"            Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <TextBlock Grid.Row="2" x:Name="StatusText"
                   Text="Ready" Foreground="Gray" Margin="0,0,0,10"/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="BtnAdd"        Width="110" Margin="0,0,8,0" Click="BtnAdd_Click"/>
            <Button x:Name="BtnRemove"     Width="110" Margin="0,0,8,0" Click="BtnRemove_Click"/>
            <Button x:Name="BtnExecute"    Width="110" Margin="0,0,8,0" Click="BtnExecute_Click"/>
            <Button x:Name="BtnExecuteAll" Width="110" Margin="0,0,8,0" Click="BtnExecuteAll_Click"/>
            <Button x:Name="BtnSettings"   Width="110"                  Click="BtnSettings_Click"/>
        </StackPanel>
    </Grid>
</Window>
