<Window x:Class="EasySave.Views.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasySave 2.0" Height="520" Width="800"
        MinHeight="400" MinWidth="600">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="EasySave 2.0"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Jobs list -->
        <DataGrid Grid.Row="1"
                  x:Name="JobsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id"     Binding="{Binding Id}"              Width="40"/>
                <DataGridTextColumn Header="Name"   Binding="{Binding Name}"            Width="*"/>
                <DataGridTextColumn Header="Source" Binding="{Binding SourceDirectory}" Width="2*"/>
                <DataGridTextColumn Header="Target" Binding="{Binding TargetDirectory}" Width="2*"/>
                <DataGridTextColumn Header="Type"   Binding="{Binding Type}"            Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <TextBlock Grid.Row="2" x:Name="StatusText"
                   Text="Ready" Foreground="Gray" Margin="0,0,0,10"/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="Add Job"         x:Name="BtnAdd"        Width="100" Margin="0,0,8,0" Click="BtnAdd_Click"/>
            <Button Content="Remove Job"      x:Name="BtnRemove"     Width="100" Margin="0,0,8,0" Click="BtnRemove_Click"/>
            <Button Content="Execute"         x:Name="BtnExecute"    Width="100" Margin="0,0,8,0" Click="BtnExecute_Click"/>
            <Button Content="Execute All"     x:Name="BtnExecuteAll" Width="100" Margin="0,0,8,0" Click="BtnExecuteAll_Click"/>
            <Button Content="Settings"        x:Name="BtnSettings"   Width="100" Margin="0,0,0,0" Click="BtnSettings_Click"/>
        </StackPanel>
    </Grid>
</Window>
