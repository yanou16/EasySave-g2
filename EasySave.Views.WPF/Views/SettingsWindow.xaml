<Window x:Class="EasySave.Views.WPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="600" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin"     Value="0,3,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height"                   Value="36"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="BorderBrush"              Value="#D1D5DB"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="White"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Margin"            Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Background"      Value="#2196F3"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="24,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>   <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="60"/>   <!-- Footer/Save -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E3A5F">
            <TextBlock x:Name="TxtSettingsTitle" Text="Settings" Foreground="White"
                       FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="20,0"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,8">

                <!-- Log Format -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="TxtSectionLogFormat" Style="{StaticResource SectionLabel}" Text="LOG FORMAT"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton x:Name="RbJson" Content="JSON" IsChecked="True"/>
                            <RadioButton x:Name="RbXml"  Content="XML"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Language -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="TxtSectionLanguage" Style="{StaticResource SectionLabel}" Text="LANGUAGE"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton x:Name="RbEn" Content="English"  IsChecked="True"/>
                            <RadioButton x:Name="RbFr" Content="Français"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Business Software -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="TxtSectionBusiness" Style="{StaticResource SectionLabel}" Text="BUSINESS SOFTWARE"/>
                        <TextBox x:Name="TxtBusinessSoftware" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtHintBusiness" Style="{StaticResource HintText}"
                                   Text="Process name without .exe — e.g. calc;Teams (semicolon-separated)"/>
                    </StackPanel>
                </Border>

                <!-- Crypto Extensions -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="TxtSectionCrypto" Style="{StaticResource SectionLabel}" Text="CRYPTO EXTENSIONS"/>
                        <TextBox x:Name="TxtCryptoExtensions" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtHintCrypto" Style="{StaticResource HintText}"
                                   Text="Extensions to encrypt — e.g. .txt;.docx;.pdf"/>
                    </StackPanel>
                </Border>

                <!-- Priority Extensions (v3.0) -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="TxtSectionPriority" Style="{StaticResource SectionLabel}" Text="PRIORITY EXTENSIONS"/>
                        <TextBox x:Name="TxtPriorityExtensions" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtHintPriority" Style="{StaticResource HintText}"
                                   Text="Copied first during parallel execution — e.g. .pdf;.docx"/>
                    </StackPanel>
                </Border>

                <!-- Max Parallel File Size (v3.0) -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="TxtSectionMaxSize" Style="{StaticResource SectionLabel}" Text="MAX PARALLEL FILE SIZE (KB)"/>
                        <TextBox x:Name="TxtMaxFileSizeKb" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtHintMaxSize" Style="{StaticResource HintText}"
                                   Text="Large files above this limit transfer one at a time. 0 = no limit."/>
                    </StackPanel>
                </Border>

                <!-- Log Destination (v3.0) -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="TxtSectionLogDest" Style="{StaticResource SectionLabel}" Text="LOG DESTINATION"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton x:Name="RbLogLocal"  Content="Local"  IsChecked="True"/>
                            <RadioButton x:Name="RbLogDocker" Content="Docker"/>
                            <RadioButton x:Name="RbLogBoth"   Content="Both"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Docker Log URL (v3.0) -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock x:Name="TxtSectionDockerUrl" Style="{StaticResource SectionLabel}" Text="DOCKER LOG SERVER URL"/>
                        <TextBox x:Name="TxtDockerLogUrl" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtHintDockerUrl" Style="{StaticResource HintText}"
                                   Text="e.g. http://localhost:5000/logs  (used when destination is Docker or Both)"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Button x:Name="BtnSave" Style="{StaticResource SaveBtn}"
                    Content="Save Settings"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,20,0" Click="BtnSave_Click"/>
        </Border>

    </Grid>
</Window>
