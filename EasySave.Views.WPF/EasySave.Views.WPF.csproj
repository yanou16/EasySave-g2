<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EasySave.GUI</AssemblyName>
    <RootNamespace>EasySave.Views.WPF</RootNamespace>
    <!-- Publish as self-contained single-file for Windows x64 — no .NET runtime required on target machine. -->
    <!-- WPF does NOT support PublishTrimmed — leave it off. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Views reference only ViewModels and Models (pure DTOs). Never EasyLog directly. -->
  <ItemGroup>
    <ProjectReference Include="..\EasySave.ViewModels\EasySave.ViewModels.csproj" />
    <ProjectReference Include="..\EasySave.Models\EasySave.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.json" />
    <None Update="Resources\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Build CryptoSoft then copy all its output files next to the WPF exe -->
  <Target Name="CopyCryptoSoftExecutable" AfterTargets="Build;Publish">
    <!-- 1. Compile CryptoSoft for the current Configuration -->
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\CryptoSoft\CryptoSoft.csproj"
             Properties="Configuration=$(Configuration)"
             Targets="Build" />

    <!-- 2. xcopy the self-contained CryptoSoft.exe (win-x64) → OutDir -->
    <Exec Command="xcopy /Y /Q &quot;$(MSBuildProjectDirectory)\..\CryptoSoft\bin\$(Configuration)\net8.0\win-x64\CryptoSoft.exe&quot; &quot;$(OutDir)&quot;" />

    <Message Text="CryptoSoft copied to $(OutDir)" Importance="high" />
  </Target>
</Project>
